<UserControl x:Class="northApi.components.BodyEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#111212" Foreground="#CCCCCC" FontSize="12">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/northApi;component/assets/RequestTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#CCCCCC"/><Setter Property="Margin" Value="0,0,14,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><StackPanel Orientation="Horizontal"><Grid Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse x:Name="Ring" Stroke="#A0A3A3" StrokeThickness="1"/><Ellipse x:Name="Dot" Fill="White" Width="5" Height="5" Visibility="Collapsed"/></Grid><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Fill" Value="#1689F5"/><Setter TargetName="Ring" Property="Stroke" Value="#1689F5"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#6BCBEA"/><Setter TargetName="Ring" Property="StrokeThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,6">
   <RadioButton Content="none" Tag="none" Checked="Mode_Changed"/>
   <RadioButton Content="form-data" Tag="form" Checked="Mode_Changed"/>
   <RadioButton Content="x-www-form-urlencoded" Tag="urlencoded" Checked="Mode_Changed"/>
   <RadioButton Content="raw" Tag="raw" IsChecked="True" Checked="Mode_Changed"/>
   <RadioButton Content="binary" Tag="binary" Checked="Mode_Changed"/>
   <RadioButton Content="GraphQL" Tag="graphql" Checked="Mode_Changed"/>
   <ComboBox x:Name="RawFormat" SelectedIndex="2" Width="105" Margin="0,-6,0,2" Foreground="#58B6F0" AutomationProperties.Name="Raw body format"><ComboBoxItem Content="Text" Tag="text/plain"/><ComboBoxItem Content="JavaScript" Tag="application/javascript"/><ComboBoxItem Content="JSON" Tag="application/json"/><ComboBoxItem Content="HTML" Tag="text/html"/><ComboBoxItem Content="XML" Tag="application/xml"/></ComboBox>
  </WrapPanel>
  <TextBlock x:Name="NoneHint" Grid.Row="1" Text="This request does not have a body." Foreground="#858989" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
  <Border x:Name="RawPanel" Grid.Row="1" BorderBrush="#3C3E3E" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="GutterScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False" Focusable="False"><TextBlock x:Name="LineNumbers" Text="1" Foreground="#898D8D" FontFamily="Consolas" FontSize="13" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextAlignment="Right" Margin="0,6,12,0"/></ScrollViewer>
   <TextBox x:Name="RawEditor" Grid.Column="1" FontFamily="Consolas" FontSize="13" TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight" BorderThickness="0" Padding="4,6" AcceptsReturn="True" AcceptsTab="True" VerticalContentAlignment="Top" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="Raw_TextChanged" ScrollViewer.ScrollChanged="Raw_ScrollChanged" AutomationProperties.Name="Request body"/>
  </Grid></Border>
  <DataGrid x:Name="FormGrid" Grid.Row="1" Visibility="Collapsed" AutomationProperties.Name="Body form fields"><DataGrid.Columns><DataGridCheckBoxColumn Binding="{Binding Enabled}" Width="34"/><DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid>
  <StackPanel x:Name="BinaryPanel" Grid.Row="1" Visibility="Collapsed"><Button Content="Select file" Click="SelectFile_Click" HorizontalAlignment="Left" Background="#292C2C"/><TextBlock x:Name="BinaryFileLabel" Text="No file selected" Foreground="#858989" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
  <Grid x:Name="GraphPanel" Grid.Row="1" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Query" Margin="0,0,0,8"/><TextBox x:Name="GraphQuery" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="GraphQL query"/><TextBlock Grid.Row="2" Text="Variables (JSON)" Margin="0,12,0,8"/><TextBox x:Name="GraphVariables" Grid.Row="3" Text="{}" AcceptsReturn="True" FontFamily="Consolas" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="GraphQL variables"/></Grid>
 </Grid>
</UserControl>
