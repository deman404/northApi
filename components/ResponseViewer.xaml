<UserControl x:Class="northApi.components.ResponseViewer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#111212" Foreground="#CCCCCC" FontFamily="Segoe UI" FontSize="12">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/northApi;component/assets/RequestTheme.xaml"/><ResourceDictionary Source="/northApi;component/assets/NothingIllustration.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#999F9F"/><Setter Property="Padding" Value="9,5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2C3233"/><Setter Property="Foreground" Value="#E0E6E6"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid>
  <Grid x:Name="ContentPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <WrapPanel Margin="10,2,10,8" VerticalAlignment="Center">
    <Border x:Name="StatusBadge" Background="#173128" CornerRadius="4" Padding="8,5" Margin="0,0,10,4"><TextBlock x:Name="StatusText" Foreground="#7EE2AE" FontWeight="SemiBold" AutomationProperties.Name="Response status"/></Border>
    <TextBlock x:Name="TimeText" VerticalAlignment="Center" Foreground="#ADB7B6" Margin="0,0,12,4" ToolTip="Time to receive the response preview"/>
    <TextBlock x:Name="SizeText" VerticalAlignment="Center" Foreground="#ADB7B6" Margin="0,0,12,4" ToolTip="Decoded response body size"/>
    <TextBlock x:Name="TypeText" VerticalAlignment="Center" Foreground="#778888" Margin="0,0,0,4"/>
   </WrapPanel>
   <TabControl Grid.Row="1" x:Name="ResultTabs">
    <TabItem Header="Body"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10" LastChildFill="False">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" ToolTip="Copy displayed response body" Padding="7,4"/><Button Content="Save" Click="Save_Click" ToolTip="Save original response text" Padding="7,4"/></StackPanel>
      <Border Background="#1B1F20" CornerRadius="4" Padding="2"><StackPanel Orientation="Horizontal"><RadioButton x:Name="PrettyMode" Content="Pretty" IsChecked="True" Checked="View_Changed"/><RadioButton Content="Raw" Checked="View_Changed"/></StackPanel></Border>
     </DockPanel>
     <Border x:Name="PreviewNotice" Grid.Row="1" Background="#30281A" CornerRadius="3" Padding="8" Margin="0,0,0,8" Visibility="Collapsed"><TextBlock Text="Large response: showing the first 8 MiB. Copy and Save contain this preview." Foreground="#E4BE77" TextWrapping="Wrap"/></Border>
     <Grid Grid.Row="2" ClipToBounds="True"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="GutterScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False" Focusable="False"><TextBlock x:Name="LineNumbers" Foreground="#586465" FontFamily="Consolas" FontSize="13" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextAlignment="Right" Margin="0,-1,10,0"/></ScrollViewer>
      <RichTextBox x:Name="CodeView" Grid.Column="1" IsReadOnly="True" IsDocumentEnabled="False" Background="#111212" Foreground="#CDD5D7" BorderThickness="0" Padding="0" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" ScrollViewer.ScrollChanged="Code_ScrollChanged" AutomationProperties.Name="Response body"><FlowDocument PagePadding="0,7,10,0" FontFamily="Consolas" FontSize="13" LineHeight="20" LineStackingStrategy="BlockLineHeight"/></RichTextBox>
     </Grid>
    </Grid></TabItem>
    <TabItem x:Name="HeadersTab" Header="Headers"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBox x:Name="HeaderFilter" TextChanged="Filter_Changed" ToolTip="Filter response headers by name or value" AutomationProperties.Name="Filter response headers" Margin="0,0,0,10"/><DataGrid x:Name="HeaderTable" Grid.Row="1" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" VerticalAlignment="Stretch" AutomationProperties.Name="Response headers"><DataGrid.Columns><DataGridTextColumn Header="Header" Binding="{Binding Name}" Width="0.9*"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="1.4*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   </TabControl>
  </Grid>
  <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
   <Image x:Name="EmptyImage" Source="{StaticResource NothingIllustration}" Width="140" Height="120" Margin="0,0,0,20"/>
   <TextBlock x:Name="EmptyTitle" Text="Ready when you are" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
   <TextBlock x:Name="EmptyHint" Text="Enter a URL and click Send to get a response." Foreground="#8D9999" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="350"/>
   <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="2" Width="140" Background="#273232" Foreground="#3095B6" BorderThickness="0" Margin="0,18,0,0" Visibility="Collapsed"/>
  </StackPanel>
 </Grid>
</UserControl>
