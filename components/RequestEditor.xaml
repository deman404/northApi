<UserControl x:Class="northApi.components.RequestEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:northApi.components" Background="#111212" Foreground="#CCCCCC" FontFamily="Segoe UI" FontSize="12">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/northApi;component/assets/RequestTheme.xaml"/><ResourceDictionary Source="/northApi;component/assets/RequestIcons.xaml"/><ResourceDictionary Source="/northApi;component/assets/SidebarIcons.xaml"/><ResourceDictionary Source="/northApi;component/assets/NothingIllustration.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="56"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="#393B3B" BorderThickness="0,0,0,1" Padding="9,0"><DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button AutomationProperties.Name="Save request" Click="Save_Click" ToolTip="Save request to collection"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource RequestSave}" Width="14" Height="14" Margin="0,0,7,0"/><TextBlock Text="Save"/></StackPanel></Button>
    <Border BorderBrush="#3C3E3E" BorderThickness="1,0,0,0" Margin="6,7"/>
    <ComboBox x:Name="EnvironmentSelector" Width="155" SelectionChanged="Environment_Changed" AutomationProperties.Name="Active environment"/><Button Content="Edit" Click="EditEnvironment_Click" ToolTip="Edit the selected environment or create one"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border BorderBrush="#526B5D" BorderThickness="1" CornerRadius="3" Padding="3" Margin="0,0,10,0"><TextBlock Text="HTTP" FontSize="8" Foreground="#8DCBA5"/></Border><TextBlock x:Name="RequestTitle" Text="Untitled Request" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Row="1" Margin="7,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
   <Border BorderBrush="#3C3E3E" BorderThickness="1" CornerRadius="3" Margin="0,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <ComboBox x:Name="MethodSelector" SelectedIndex="0" Foreground="{Binding SelectedItem.Foreground, RelativeSource={RelativeSource Self}}" FontWeight="SemiBold" AutomationProperties.Name="HTTP method">
     <ComboBoxItem Content="GET" Foreground="#73DDA3"/>
     <ComboBoxItem Content="POST" Foreground="#F2C66D"/>
     <ComboBoxItem Content="PUT" Foreground="#75B9F5"/>
     <ComboBoxItem Content="PATCH" Foreground="#BD9CF5"/>
     <ComboBoxItem Content="DELETE" Foreground="#F48787"/>
     <ComboBoxItem Content="HEAD" Foreground="#66D4D4"/>
     <ComboBoxItem Content="OPTIONS" Foreground="#E6A1D8"/>
    </ComboBox>
    <Grid Grid.Column="1"><TextBlock Text="Enter URL or paste text" Foreground="#727676" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=UrlBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox x:Name="UrlBox" Background="Transparent" BorderThickness="0" KeyDown="Url_KeyDown" AutomationProperties.Name="Request URL"/></Grid>
   </Grid></Border>
   <Button x:Name="SendButton" Grid.Column="1" Content="Send" Style="{StaticResource SendButton}" Click="Send_Click" ToolTip="Send request (Ctrl+Enter)"/>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*" MinWidth="240"/></Grid.ColumnDefinitions>
   <TabControl x:Name="RequestOptions">
    <TabItem Header="Params"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Query Params" Margin="0,0,0,9"/><DataGrid x:Name="ParamsGrid" AutomationProperties.Name="Query parameters"><DataGrid.Columns><DataGridCheckBoxColumn Binding="{Binding Enabled}" Width="38"/><DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
    <TabItem Header="Authorization"><local:AuthorizationEditor x:Name="Authorization"/></TabItem>
    <TabItem Header="Headers"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Request Headers" Margin="0,0,0,9"/><DataGrid x:Name="HeadersGrid" AutomationProperties.Name="Request headers"><DataGrid.Columns><DataGridCheckBoxColumn Binding="{Binding Enabled}" Width="38"/><DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
    <TabItem Header="Body"><local:BodyEditor x:Name="RequestBodyEditor"/></TabItem>
    <TabItem Header="Scripts"><TextBlock Text="Request scripts are not supported yet." Foreground="#858989" TextWrapping="Wrap"/></TabItem>
    <TabItem Header="Settings"><StackPanel><TextBlock Text="Request timeout (seconds)" Margin="0,0,0,9"/><TextBox x:Name="TimeoutBox" Text="30" Width="100" HorizontalAlignment="Left" AutomationProperties.Name="Request timeout"/><TextBlock Text="Redirects are followed automatically." Foreground="#858989" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></TabItem>
   </TabControl>
   <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="#3C3E3E"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel Margin="9,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Code" Foreground="#5DB7E5" Click="Code_Click" ToolTip="Generate C# or cURL"/><Button Content="Cookies" Foreground="#5DB7E5" Click="Cookies_Click"/></StackPanel><TextBlock Text="Response" VerticalAlignment="Center"/></DockPanel>
    <local:ResponseViewer x:Name="ResponsePanel" Grid.Row="1"/>
   </Grid>
  </Grid>
  <TextBlock x:Name="PersistenceNotice" Grid.Row="3" Visibility="Collapsed" Foreground="#E4BE77" TextWrapping="Wrap" Margin="8"/>
 </Grid>
</UserControl>
