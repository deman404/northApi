<UserControl x:Class="northApi.components.AuthorizationEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#CCCCCC" Background="#111212">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/northApi;component/assets/RequestTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.36*" MinWidth="170"/><ColumnDefinition Width="0.64*"/></Grid.ColumnDefinitions>
  <Border BorderBrush="#3C3E3E" BorderThickness="0,0,1,0" Padding="12,8,12,0"><StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Type" VerticalAlignment="Center"/>
    <ComboBox x:Name="AuthTypeSelector" Grid.Column="1" SelectedIndex="0" SelectionChanged="AuthType_Changed" AutomationProperties.Name="Authorization type" ToolTip="Choose an authorization type">
     <ComboBoxItem Content="Inherit auth from parent" Tag="inherit"/>
     <ComboBoxItem Content="No Auth" Tag="none"/>
     <ComboBoxItem Content="API Key" Tag="apiKey"/>
     <ComboBoxItem Content="Basic Auth" Tag="basic"/>
     <ComboBoxItem Content="Bearer Token" Tag="bearer"/>
     <ComboBoxItem Content="OAuth 2.0" Tag="oauth2"/>
     <ComboBoxItem Content="AWS Signature" Tag="aws" IsEnabled="False" ToolTip="AWS request signing is not available yet"/>
     <ComboBoxItem Content="OAuth 1.0" Tag="oauth1" IsEnabled="False" ToolTip="OAuth 1.0 signing is not available yet"/>
    </ComboBox>
   </Grid>
   <TextBlock x:Name="AuthDescription" Text="The authorization header will be automatically generated when you send the request." TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="17"/>
  </StackPanel></Border>
  <Grid Grid.Column="1" Margin="18,8,16,12">
   <TextBlock x:Name="AuthMessage" Text="This request is not inheriting any authorization helper at the moment. Save it in a collection to use the parent's authorization helper." TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" LineHeight="17"/>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <StackPanel x:Name="ApiKeyFields" Visibility="Collapsed"><TextBlock Text="Key" Margin="0,0,0,8"/><TextBox x:Name="ApiKeyName" AutomationProperties.Name="API key name"/><TextBlock Text="Value" Margin="0,18,0,8"/><TextBox x:Name="ApiKeyValue" AutomationProperties.Name="API key value"/><TextBlock Text="Add to" Margin="0,18,0,8"/><ComboBox x:Name="ApiKeyLocation" SelectedIndex="0" AutomationProperties.Name="API key location"><ComboBoxItem Content="Header"/><ComboBoxItem Content="Query Params"/></ComboBox></StackPanel>
    <StackPanel x:Name="BasicFields" Visibility="Collapsed"><TextBlock Text="Username" Margin="0,0,0,8"/><TextBox x:Name="UsernameBox" AutomationProperties.Name="Auth username"/><TextBlock Text="Password" Margin="0,18,0,8"/><PasswordBox x:Name="PasswordInput" Padding="8,6" Background="#111212" Foreground="#CCCCCC" BorderBrush="#3C3E3E" CaretBrush="White" AutomationProperties.Name="Auth password"/></StackPanel>
    <StackPanel x:Name="TokenFields" Visibility="Collapsed"><TextBlock x:Name="TokenLabel" Text="Token" Margin="0,0,0,8"/><TextBox x:Name="TokenInput" AutomationProperties.Name="Authorization token"/><TextBlock x:Name="TokenHelp" Text="The token is sent in the Authorization header using the Bearer scheme." Foreground="#858989" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="17"/></StackPanel>
   </StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
