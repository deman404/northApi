<Window x:Class="northApi.pages.WorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:northApi.components" Title="northApi — Workspace" Icon="/northApi;component/assets/app.ico" Width="1100" Height="760" MinWidth="700" MinHeight="480" WindowStartupLocation="CenterScreen" Background="#202121" Foreground="#C6C6C6" FontFamily="Segoe UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/northApi;component/assets/NothingIllustration.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="310" MinWidth="260" MaxWidth="440"/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <components:Sidebar x:Name="NavigationSidebar" NewRequestRequested="NewRequest_Requested" ConsoleRequested="Console_Requested"/>
  <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#262828"/>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=RequestTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <Image Source="{StaticResource NothingIllustration}" Width="140" Height="120" Stretch="Uniform" AutomationProperties.Name="No open requests"/>
    <TextBlock Text="NorthApi" FontSize="22" FontWeight="SemiBold" Foreground="#C6C6C6" HorizontalAlignment="Center" Margin="0,16,0,0"/>
   </StackPanel>
   <TabControl x:Name="RequestTabs" Background="#111212" BorderThickness="0">
    <TabControl.Resources>
     <Style TargetType="TabItem"><Setter Property="Foreground" Value="#DDDDDD"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="#202121" Padding="8,7" CornerRadius="4,4,0,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#111212"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </TabControl.Resources>
    <TabControl.Style><Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Border Background="#202121" BorderBrush="#393B3B" BorderThickness="0,0,0,1"><TabPanel IsItemsHost="True"/></Border><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TabControl.Style>
   </TabControl>
   <Border x:Name="ConsolePanel" Grid.Row="1" Visibility="Collapsed" BorderBrush="#3A3D3D" BorderThickness="0,1,0,0" Padding="0,16" Margin="0,20,0,0"><StackPanel><TextBlock Text="Console" FontWeight="SemiBold"/><TextBlock Text="No requests have been sent." Foreground="#858989" Margin="0,8,0,0"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
